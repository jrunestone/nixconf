{
  name = "default"
  position = "bottom"
  exclusive_zone = false
  start = []
  center = []
  end = [
    {
      type = "battery"
      show_icon = false
      show_if = "[ -f /sys/class/power_supply/BAT0/capacity ]"
    }
    {
      type = "label"
      label = ""
      class = "vpn"
      show_if = {
        cmd = "/run/current-system/sw/bin/curl -s https://integrity.st/iptest.php | /run/current-system/sw/bin/grep -q '1'"
        interval = 10000
      }
    }
    {
      type = "clock"
      format = "%H:%M"
      show_week_numbers = true
    }
  ]
}
